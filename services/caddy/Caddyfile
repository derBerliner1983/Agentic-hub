# V.A.U.L.T. Reverse-Proxy
#
# Port 80  → leitet auf HTTPS um.
# Port 443 → HUD über HTTPS mit einem selbst-signierten Zertifikat, das die
#            richtigen Namen enthält (*.local, localhost, LAN-IP) – erzeugt von
#            scripts/gen-cert.sh. Dadurch KEIN Namens-Mismatch; die Browser-
#            Warnung ist normal wegklickbar. KEIN HSTS (LAN-IP-Falle).

{
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
}

:80 {
	redir https://{host}{uri} permanent
}

:443 {
	tls /certs/cert.pem /certs/key.pem
	reverse_proxy orchestrator:3000
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "no-referrer"
		-Server
	}
}
