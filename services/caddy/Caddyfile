# V.A.U.L.T. Reverse-Proxy
#
# Port 80  → leitet auf HTTPS um.
# Port 443 → HUD über HTTPS mit intern signiertem Zertifikat.
#            Beim ersten Aufruf: Zertifikatswarnung „Erweitert → trotzdem fortfahren".
#
# WICHTIG: KEIN HSTS! Bei einer LAN-IP mit selbst-signiertem Zertifikat würde HSTS
# den Browser zwingen, HTTPS auch auf dem HTTP-Port zu erzwingen (→ SSL-Fehler)
# und die Zertifikatswarnung nicht mehr wegklickbar machen.

{
	auto_https disable_redirects
	local_certs
	servers {
		protocols h1 h2
	}
}

:80 {
	redir https://{host}{uri} permanent
}

:443 {
	reverse_proxy orchestrator:3000
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "no-referrer"
		-Server
	}
}
