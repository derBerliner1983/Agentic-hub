# V.A.U.L.T. Reverse-Proxy
#
# Port 80  → leitet automatisch auf HTTPS um.
# Port 443 → HUD über HTTPS mit intern signiertem Zertifikat (tls internal).
#            Beim ersten Aufruf zeigt der Browser eine Zertifikatswarnung
#            (selbst-signiert) – einmal „trotzdem fortfahren" klicken.
#            Für eine echte Domain die 'tls internal'-Zeile entfernen und
#            einen Hostnamen statt 'https://' eintragen.

{
	# Wir definieren die HTTP→HTTPS-Weiterleitung selbst.
	auto_https disable_redirects
}

# Alles auf HTTP → dauerhaft auf HTTPS umleiten (gleicher Host).
http:// {
	redir https://{host}{uri} permanent
}

# HTTPS
https:// {
	tls internal
	reverse_proxy orchestrator:3000
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "no-referrer"
		-Server
	}
}
