# V.A.U.L.T. Reverse-Proxy
#
# Port 80  → leitet auf HTTPS um.
# Port 443 → HUD über HTTPS mit intern signiertem Zertifikat.
#            Beim ersten Aufruf zeigt der Browser eine Zertifikatswarnung
#            (selbst-signiert) – „Erweitert" → „trotzdem fortfahren".
#
# 'local_certs' erzwingt global intern signierte Zertifikate (auch für IPs) –
# so serviert Port 443 zuverlässig TLS.

{
	auto_https disable_redirects
	local_certs
}

:80 {
	redir https://{host}{uri} permanent
}

:443 {
	reverse_proxy orchestrator:3000
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "no-referrer"
		-Server
	}
}
